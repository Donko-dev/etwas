# ============================================================================
# ETWAS SERVER — modèle de configuration.
# Copie ce fichier en ".env" (jamais ".env.example" lui-même) et renseigne
# tes vraies valeurs. Ne commite JAMAIS le fichier ".env" réel dans Git.
#
# ⚠️ CONTEXTE ACTUEL : le site (index.html + modules) est hébergé sur GitHub
# en attendant la vraie mise en production sur etwas.com. Ce serveur n'a PAS
# besoin d'être déployé pour que le site GitHub fonctionne — il reste le
# code prêt pour le jour du vrai déploiement sur ton VPS Hostinger.
# ============================================================================

PORT=3000

# --- Base de données MySQL (Hostinger : hébergement → Bases de données) ---
# Importe d'abord schema.sql dans cette base avant le premier démarrage.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=etwas

# Jeton d'administration — génère une valeur aléatoire longue, par exemple :
#   openssl rand -hex 32
ETWAS_ADMIN_TOKEN=

# Domaine autorisé à appeler ce serveur depuis le navigateur (CORS).
ETWAS_ALLOWED_ORIGIN=

# URL publique de ce serveur (nécessaire pour le callback Plisio et les
# retours Stripe), ex: https://api.etwas.example.com
ETWAS_PUBLIC_URL=

# --- KKiaPay (Mobile Money & carte, actif en production) ---
KKIAPAY_PUBLIC_KEY=
KKIAPAY_SECRET_KEY=

# --- Plisio (crypto, actif en production) ---
PLISIO_API_KEY=

# --- Stripe (en attente des clés DONKO UG) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- PayPal (en attente des tokens d'activation) ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=live
